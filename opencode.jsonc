{
  "$schema": "https://opencode.ai/config.json",

  // ============================================================
  // User preferences
  // - Primary: Gemini (when available)
  // - Fallback: NVIDIA (use now if Gemini quota is 0)
  // - Do not use paid Claude unless explicitly requested
  // ============================================================
  "disabled_providers": ["anthropic"],
  "model": "nvidia/meta/llama-3.1-8b-instruct",
  "small_model": "nvidia/meta/llama-3.1-8b-instruct",

  // ============================================================
  // MCP servers (tools)
  // Phase 1 requires: filesystem + github + memory + sqlite
  // Others are optional; leave them enabled if you use them.
  // ============================================================
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "./github-repos"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory", "--db-path", "./memory/sqlite/memory.db"],
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": ["npx", "-y", "mcp-sqlite", "./memory/sqlite/jarvis.db"],
      "enabled": true
    },
    "browser": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "brave-search": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-brave-search"],
      "enabled": false
    },
    "docker": {
      "type": "local",
      "command": ["npx", "-y", "@hypnosis/docker-mcp-server"],
      "enabled": false
    },
    "fetch": {
      "type": "local",
      "command": ["npx", "-y", "mcp-fetch-server"],
      "enabled": true
    }
  }
}

