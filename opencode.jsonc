{
  "$schema": "https://opencode.ai/config.json",

  // ============================================================
  // Provider configuration
  // - Primary: Ollama (local, free, private) + OpenAI
  // - Disabled: Anthropic (subscription), Google/Gemini (flagged)
  // ============================================================
  "disabled_providers": ["anthropic", "google"],
  "model": "ollama/llama3.2",
  "small_model": "ollama/llama3.2",

  // ============================================================
  // MCP servers (tools)
  // Phase 1 requires: filesystem + github + memory + sqlite
  // Others are optional; leave them enabled if you use them.
  // ============================================================
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "./github-repos"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory", "--db-path", "./memory/sqlite/memory.db"],
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": ["npx", "-y", "mcp-sqlite", "./memory/sqlite/jarvis.db"],
      "enabled": true
    },
    "browser": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "brave-search": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-brave-search"],
      "enabled": false
    },
    "search": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-fetch"],
      "env": { "SEARXNG_URL": "http://localhost:8888" },
      "enabled": true
    },
    "code-sandbox": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sandbox"],
      "enabled": true
    },
    "docker": {
      "type": "local",
      "command": ["npx", "-y", "@hypnosis/docker-mcp-server"],
      "enabled": false
    },
    "fetch": {
      "type": "local",
      "command": ["npx", "-y", "mcp-fetch-server"],
      "enabled": true
    },
    "calendar": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-google-calendar"],
      "enabled": true
    }
  }
}
