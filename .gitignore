# =============================================================================
# JARVIS .gitignore — Never commit secrets or sensitive data
# =============================================================================

# Secrets and credentials
.env
.env.local
*.env
infrastructure/secrets/*
!infrastructure/secrets/.gitkeep
secrets/*
!secrets/.gitkeep

# Specific sensitive files
security/vault-keys.txt
security/neo4j-auth.txt
security/.vault-keys.json
security/.vault-root-token
security/.secret-registry.json
security/*.txt

# API keys and tokens (root-level configs with secrets only)
/config.json
/credentials.json

# Sensitive data
**/*.pem
**/*.key
**/id_rsa*
**/*.cert
infrastructure/certs/**/*.key

# Vector database data (can contain indexed documents)
memory/chroma/*
!memory/chroma/.gitkeep

# SQLite databases (can contain task history and secrets)
memory/sqlite/*.db
memory/sqlite/*.db-journal
memory/sqlite/*.db-wal
memory/sqlite/*.db-shm

# Logs
logs/*
!logs/.gitkeep

# Docker data volumes
data/

# Local editor/runtime caches
.cursor/
.playwright-mcp/
node_modules.off/
--help
memory/rate-limiter-state.json

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.idea/
.vscode/
*.sublime-*

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.venv-1/
venv/
*.egg-info/

# Node
node_modules/
npm-debug.log*

# Dependencies
.pnp
.pnp.js
