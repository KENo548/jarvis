# =============================================================================
# JARVIS Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env files to git.
# =============================================================================

# --- API Keys (local-only by default) ---
# Leave these empty unless you intentionally override the local-first policy.
GOOGLE_API_KEY=
NVIDIA_API_KEY=
# Legacy cloud keys are intentionally left blank.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=ghp_your-token-here

# --- Services ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_ENABLE=false
N8N_HOST=localhost
N8N_PORT=5678
GRAFANA_HOST=localhost
GRAFANA_PORT=3000
VAULT_HOST=localhost
VAULT_PORT=8200
SEARXNG_HOST=localhost
SEARXNG_PORT=8888
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_UI_PORT=7474

# --- Storage Paths ---
OBSIDIAN_VAULT_PATH=./memory/obsidian-vault
CHROMA_PERSIST_DIR=./memory/chroma
SQLITE_DB_PATH=./memory/sqlite/jarvis.db

# --- Agent Configuration ---
LOG_LEVEL=info
MAX_CONCURRENT_AGENTS=3
AUTO_APPROVE_READS=true
AUTO_APPROVE_WEB_SEARCH=true
REQUIRE_APPROVAL_FOR_WRITES=true
REQUIRE_APPROVAL_FOR_GIT=true
REQUIRE_APPROVAL_FOR_SHELL=true
REQUIRE_APPROVAL_FOR_DEPLOY=true

# --- Security ---
KILL_SWITCH_ENABLED=true
AUDIT_LOG_PATH=./logs/audit.log
SECRET_SCANNING_ENABLED=true
MAX_LOGIN_ATTEMPTS=3
SESSION_TIMEOUT_MINUTES=60

# --- Optional: Local LLM ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
